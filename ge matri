// Function to calculate Gematria value
function calculate_gematria($word, $gematria_dict) {
    $sum = 0;
    $word = strtoupper($word);
    for ($i = 0; $i < strlen($word); $i++) {
        $char = $word[$i];
        if (isset($gematria_dict[$char])) {
            $sum += $gematria_dict[$char];
        }
    }
    return $sum;
}

